#!/bin/bash
# Launch the WhatsApp Claude session: only the WhatsApp MCP server, auto mode
# (--manual for a prompt on every action), bypass disabled, from a neutral
# directory so no project settings apply. ADR 2026-10-24-f10233.
WA_HOME="${WA_HOME:-$HOME/.whatsapp-mcp}"
# Cheap model unless the caller picks one (--model or WA_MODEL)
model=(--model "${WA_MODEL:-haiku}")
mode=auto
args=()
for a in "$@"; do
  case "$a" in
    --model|--model=*) model=() ;;
    --manual) mode=default; continue ;;
  esac
  args+=("$a")
done
set -- "${args[@]}"
for a in "$@"; do
  case "$a" in
    --dangerously-skip-permissions|--allow-dangerously-skip-permissions|--permission-mode|--permission-mode=*|--mcp-config|--mcp-config=*|--settings|--settings=*)
      echo "wa: $a is not allowed in a WhatsApp session" >&2; exit 1 ;;
  esac
done
[ -f "$WA_HOME/mcp.json" ] || { echo "wa: not installed; run /wa-setup in Claude Code" >&2; exit 1; }
mkdir -p "$WA_HOME/workspace" && cd "$WA_HOME/workspace" || exit 1
exec claude --mcp-config "$WA_HOME/mcp.json" --strict-mcp-config \
  --settings "$WA_HOME/settings.json" --permission-mode "$mode" "${model[@]}" "$@"
